; NaNLM-0 model image (generated, do not edit)
; dim=2048 words=64 classes=16 queries=32
.equ NVEC 16
.equ VW 64
.equ NQ 32
.equ BEST_INIT 2049
.org 0
main:
MOVI r13,1
MOVI r1,0
ST r1,r0,@m_q
LA r1,@queries
ST r1,r0,@m_ptr
m_loop:
LD r1,r0,@m_q
MOVI r2,#NQ
CMP r1,r2
JMP[GE] @m_done
LD r1,r0,@m_ptr
CALL @predict
CALL @puthex2
MOVI r1,10
PUTC r1
LD r1,r0,@m_ptr
MOVI r2,#VW
ADD r1,r1,r2
ST r1,r0,@m_ptr
LD r1,r0,@m_q
ADD r1,r1,r13
ST r1,r0,@m_q
JMP @m_loop
m_done:
HALT
predict:
ST r15,r0,@p_ret
ST r1,r0,@p_qptr
MOVI r1,#BEST_INIT
ST r1,r0,@p_best
MOVI r1,0
ST r1,r0,@p_bestc
MOVI r1,0
ST r1,r0,@p_c
LA r1,@prototypes
ST r1,r0,@p_proto
p_loop:
LD r1,r0,@p_c
MOVI r2,#NVEC
CMP r1,r2
JMP[GE] @p_done
LD r1,r0,@p_qptr
LD r2,r0,@p_proto
CALL @hamming
LD r2,r0,@p_best
CMP r1,r2
JMP[GE] @p_next
ST r1,r0,@p_best
LD r2,r0,@p_c
ST r2,r0,@p_bestc
p_next:
LD r1,r0,@p_proto
MOVI r2,#VW
ADD r1,r1,r2
ST r1,r0,@p_proto
LD r1,r0,@p_c
ADD r1,r1,r13
ST r1,r0,@p_c
JMP @p_loop
p_done:
LD r1,r0,@p_bestc
LD r15,r0,@p_ret
RET
hamming:
ST r15,r0,@h_ret
ADD r8,r1,r0
ADD r9,r2,r0
MOVI r10,0
MOVI r11,0
h_loop:
MOVI r1,#VW
CMP r10,r1
JMP[GE] @h_done
LD r1,r8,0
LD r2,r9,0
BOOL.6 r1,r1,r2
CALL @popcount32
ADD r11,r11,r1
ADD r8,r8,r13
ADD r9,r9,r13
ADD r10,r10,r13
JMP @h_loop
h_done:
ADD r1,r11,r0
LD r15,r0,@h_ret
RET
popcount32:
SHR r2,r1,1
MOVI r3,0x5555
MOVHI r3,0x5555
BOOL.8 r2,r2,r3
SUB r1,r1,r2
MOVI r3,0x3333
MOVHI r3,0x3333
BOOL.8 r2,r1,r3
SHR r4,r1,2
BOOL.8 r4,r4,r3
ADD r1,r2,r4
SHR r2,r1,4
ADD r1,r1,r2
MOVI r3,0x0F0F
MOVHI r3,0x0F0F
BOOL.8 r1,r1,r3
MOVI r3,0x0101
MOVHI r3,0x0101
MUL r1,r1,r3
SHR r1,r1,24
RET
puthex:
MOVI r2,10
CMP r1,r2
JMP[LT] @ph_num
MOVI r2,55
ADD r1,r1,r2
PUTC r1
RET
ph_num:
MOVI r2,48
ADD r1,r1,r2
PUTC r1
RET
puthex2:
ST r15,r0,@ph2_ret
ST r1,r0,@ph2_val
SHR r1,r1,4
CALL @puthex
LD r1,r0,@ph2_val
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r15,r0,@ph2_ret
RET
m_q:
.word 0
m_ptr:
.word 0
p_ret:
.word 0
p_qptr:
.word 0
p_c:
.word 0
p_best:
.word 0
p_bestc:
.word 0
p_proto:
.word 0
h_ret:
.word 0
ph2_ret:
.word 0
ph2_val:
.word 0
.org 8192
