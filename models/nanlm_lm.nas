; NaNLM byte-level model (generated, do not edit)
; dim=2048 words=64 vocab=256 queries=32 context=3
.equ NVEC 1024
.equ VW 64
.equ NQ 32
.equ CTX 3
.equ PROTOSHIFT 2
.equ BEST_INIT 2049
.org 0
main:
MOVI r13,1
MOVI r1,0
ST r1,r0,@m_q
LA r1,@query_ids
ST r1,r0,@m_ids
m_loop:
LD r1,r0,@m_q
MOVI r2,#NQ
CMP r1,r2
JMP[GE] @m_done
LD r1,r0,@m_ids
LA r2,@qbuf
CALL @encode
LA r1,@qbuf
CALL @hash
ST r1,r0,@m_hash
LA r1,@qbuf
CALL @predict
SHR r1,r1,#PROTOSHIFT
ST r1,r0,@m_class
LD r1,r0,@m_class
CALL @puthex2
MOVI r1,32
PUTC r1
LD r1,r0,@m_hash
CALL @puthex8
MOVI r1,10
PUTC r1
LD r1,r0,@m_ids
MOVI r2,#CTX
ADD r1,r1,r2
ST r1,r0,@m_ids
LD r1,r0,@m_q
ADD r1,r1,r13
ST r1,r0,@m_q
JMP @m_loop
m_done:
HALT
encode:
ST r15,r0,@e_ret
ST r1,r0,@e_ids
ST r2,r0,@e_dst
MOVI r1,0
ST r1,r0,@e_i
e_loop:
LD r1,r0,@e_i
MOVI r2,#CTX
CMP r1,r2
JMP[GE] @e_bundle
LD r3,r0,@e_ids
ADD r3,r3,r1
LD r4,r3,0
MOVI r5,#VW
MUL r4,r4,r5
LA r5,@codebook
ADD r5,r5,r4
LD r3,r0,@e_i
MOVI r4,#VW
MUL r3,r3,r4
LA r4,@positions
ADD r4,r4,r3
LD r3,r0,@e_i
MOVI r6,#VW
MUL r3,r3,r6
LA r6,@tmp0
ADD r6,r6,r3
ADD r1,r6,r0
ADD r2,r5,r0
ADD r3,r4,r0
CALL @vec_xor
LD r1,r0,@e_i
ADD r1,r1,r13
ST r1,r0,@e_i
JMP @e_loop
e_bundle:
LD r1,r0,@e_dst
LA r2,@tmp0
LA r3,@tmp1
LA r4,@tmp2
CALL @vec_majority
LD r15,r0,@e_ret
RET
vec_xor:
MOVI r4,0
MOVI r5,#VW
vx_loop:
CMP r4,r5
JMP[GE] @vx_done
LD r6,r2,0
LD r7,r3,0
BOOL.6 r6,r6,r7
ST r6,r1,0
ADD r1,r1,r13
ADD r2,r2,r13
ADD r3,r3,r13
ADD r4,r4,r13
JMP @vx_loop
vx_done:
RET
vec_majority:
MOVI r5,0
MOVI r6,#VW
vm_loop:
CMP r5,r6
JMP[GE] @vm_done
LD r7,r2,0
LD r8,r3,0
LD r9,r4,0
BOOL.8 r10,r7,r8
BOOL.8 r11,r7,r9
BOOL.8 r12,r8,r9
BOOL.14 r10,r10,r11
BOOL.14 r10,r10,r12
ST r10,r1,0
ADD r1,r1,r13
ADD r2,r2,r13
ADD r3,r3,r13
ADD r4,r4,r13
ADD r5,r5,r13
JMP @vm_loop
vm_done:
RET
hash:
MOVI r2,0x9DC5
MOVHI r2,0x811C
MOVI r3,0
MOVI r5,0x0193
MOVHI r5,0x0100
MOVI r6,#VW
hash_loop:
CMP r3,r6
JMP[GE] @hash_done
LD r4,r1,0
BOOL.6 r2,r2,r4
MUL r2,r2,r5
ADD r1,r1,r13
ADD r3,r3,r13
JMP @hash_loop
hash_done:
ADD r1,r2,r0
RET
predict:
ST r15,r0,@p_ret
ST r1,r0,@p_qptr
MOVI r1,#BEST_INIT
ST r1,r0,@p_best
MOVI r1,0
ST r1,r0,@p_bestc
MOVI r1,0
ST r1,r0,@p_c
LA r1,@prototypes
ST r1,r0,@p_proto
p_loop:
LD r1,r0,@p_c
MOVI r2,#NVEC
CMP r1,r2
JMP[GE] @p_done
LD r1,r0,@p_qptr
LD r2,r0,@p_proto
CALL @hamming
LD r2,r0,@p_best
CMP r1,r2
JMP[GE] @p_next
ST r1,r0,@p_best
LD r2,r0,@p_c
ST r2,r0,@p_bestc
p_next:
LD r1,r0,@p_proto
MOVI r2,#VW
ADD r1,r1,r2
ST r1,r0,@p_proto
LD r1,r0,@p_c
ADD r1,r1,r13
ST r1,r0,@p_c
JMP @p_loop
p_done:
LD r1,r0,@p_bestc
LD r15,r0,@p_ret
RET
hamming:
ST r15,r0,@h_ret
ADD r8,r1,r0
ADD r9,r2,r0
MOVI r10,0
MOVI r11,0
ham_loop:
MOVI r1,#VW
CMP r10,r1
JMP[GE] @ham_done
LD r1,r8,0
LD r2,r9,0
BOOL.6 r1,r1,r2
CALL @popcount32
ADD r11,r11,r1
ADD r8,r8,r13
ADD r9,r9,r13
ADD r10,r10,r13
JMP @ham_loop
ham_done:
ADD r1,r11,r0
LD r15,r0,@h_ret
RET
popcount32:
SHR r2,r1,1
MOVI r3,0x5555
MOVHI r3,0x5555
BOOL.8 r2,r2,r3
SUB r1,r1,r2
MOVI r3,0x3333
MOVHI r3,0x3333
BOOL.8 r2,r1,r3
SHR r4,r1,2
BOOL.8 r4,r4,r3
ADD r1,r2,r4
SHR r2,r1,4
ADD r1,r1,r2
MOVI r3,0x0F0F
MOVHI r3,0x0F0F
BOOL.8 r1,r1,r3
MOVI r3,0x0101
MOVHI r3,0x0101
MUL r1,r1,r3
SHR r1,r1,24
RET
puthex:
MOVI r2,10
CMP r1,r2
JMP[LT] @ph_num
MOVI r2,55
ADD r1,r1,r2
PUTC r1
RET
ph_num:
MOVI r2,48
ADD r1,r1,r2
PUTC r1
RET
puthex2:
ST r15,r0,@ph2_ret
ST r1,r0,@ph2_val
SHR r1,r1,4
CALL @puthex
LD r1,r0,@ph2_val
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r15,r0,@ph2_ret
RET
puthex8:
ST r15,r0,@ph8_ret
ST r1,r0,@ph8_val
LD r1,r0,@ph8_val
SHR r1,r1,28
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r1,r0,@ph8_val
SHR r1,r1,24
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r1,r0,@ph8_val
SHR r1,r1,20
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r1,r0,@ph8_val
SHR r1,r1,16
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r1,r0,@ph8_val
SHR r1,r1,12
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r1,r0,@ph8_val
SHR r1,r1,8
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r1,r0,@ph8_val
SHR r1,r1,4
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r1,r0,@ph8_val
MOVI r2,15
BOOL.8 r1,r1,r2
CALL @puthex
LD r15,r0,@ph8_ret
RET
m_q:
.word 0
m_ids:
.word 0
m_hash:
.word 0
m_class:
.word 0
e_ret:
.word 0
e_ids:
.word 0
e_dst:
.word 0
e_i:
.word 0
p_ret:
.word 0
p_qptr:
.word 0
p_c:
.word 0
p_best:
.word 0
p_bestc:
.word 0
p_proto:
.word 0
h_ret:
.word 0
ph2_ret:
.word 0
ph2_val:
.word 0
ph8_ret:
.word 0
ph8_val:
.word 0
.org 8192
